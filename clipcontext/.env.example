# ---- ClipContext Part 1 -------------------------------------------------
# Copy to .env and fill in the keys. Everything else has working defaults.

# Free API keys
GOOGLE_API_KEY=            # Gemini (AI Studio): clip selection, frame captions, judge
GROQ_API_KEY=              # Groq: Whisper transcription + metadata generation
YOUTUBE_API_KEY=           # YouTube Data API v3 key (search only, no OAuth)

# Database and media folder for running the api/worker directly on your machine.
# (Docker Compose overrides both for its containers, so these are safe to keep.)
DATABASE_URL=postgresql://clipcontext:clipcontext@localhost:5432/clipcontext
MEDIA_DIR=./media

# Caption font. On Windows, Arial is a safe choice if Noto Sans is not installed.
SUBTITLE_FONT=Noto Sans

# Optional shared secret for the API (single-user tool). Leave empty on a private machine.
API_TOKEN=

# Language default for new sources: en | hinglish (Latin script)
DEFAULT_LANGUAGE_MODE=en

# Transcription: auto (Groq if key, else local) | groq | local
TRANSCRIPTION_PROVIDER=auto
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_THREADS=6

# LLM fallback chains (provider:model, comma separated, first = preferred)
LLM_SELECTION_MODELS=google:gemini-3.8-flash,google:gemini-3.5-flash,google:gemini-3.5-flash-lite
LLM_VISION_MODELS=google:gemini-3.8-flash,google:gemini-3.5-flash,google:gemini-3.5-flash-lite
LLM_GENERATOR_MODELS=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,google:gemini-3.5-flash-lite
LLM_JUDGE_MODELS=google:gemini-3.8-flash,google:gemini-3.5-flash,groq:qwen/qwen3.8-27b
LLM_HELPER_MODELS=groq:qwen/qwen3.8-27b,google:gemini-3.5-flash-lite

# Free-tier budget controls
JUDGE_SHUFFLES=2           # rubric passes per pool (1 halves judge calls)
PAIRWISE_TOP=5             # candidates compared head-to-head
NICHE_MAX_SEARCH_CALLS=3   # YouTube search.list calls per long video (100/day quota)

# Clips
CLIPS_MIN=3
CLIPS_MAX=10
MINUTES_PER_CLIP=15
CLIP_MIN_S=20
CLIP_MAX_S=60

# CPU (6 cores): 2 clips in parallel, 3 ffmpeg threads each
WORKER_CONCURRENCY=2
RENDER_THREADS=3
